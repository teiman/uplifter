{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ModEditor",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/modeditor",
      "command": "npm start",
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
