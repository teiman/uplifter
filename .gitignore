# Node
node_modules/
*.log
npm-debug.log*

# Vite build output (regenerated)
modeditor/dist/

# Editor temp/runtime
modeditor/tmp/
modeditor/.vite/

# OS / IDE clutter
.DS_Store
Thumbs.db
*.swp
*.bak

# ericw-tools binaries: 200+ MB, easier to keep in source-of-truth (atlasmaper)
# and re-copy than to vendor. Comment this line out if you want them committed.
modeditor/bin/

# Compiled mod outputs (regenerate from the modeditor)
modeditor/*.bsp
modeditor/*.pts
modeditor/*.prt
modeditor/*.lit

# Mod build artifacts (regenerate with mod/build.bat). build.bat compiles in
# the mod dir and copies the .dat to the install; these are intermediates.
mod/progs.dat
mod/csprogs.dat
mod/progs.lno
mod/csprogs.lno
# Same artifacts if fteqcc ever writes them at the repo root (older flows).
/progs.dat
/csprogs.dat
/progs.lno
/csprogs.lno

# Mod runtime state from the installed copy (do not version)
mod/autosave/
mod/screenshots/
mod/ironwail.cfg
mod/config.cfg

# Mapas: los escribe el ModEditor directamente en D:\quake\uplifter\maps\,
# no se versionan aqui.
mod/maps/

# fteqcc binary: keep locally, do not commit
mod/bin/

# Skyboxes heredados de airquake (~119 MB) — solo versionamos el de Uplifter.
mod/gfx/env/*
!mod/gfx/env/uplifter_*

# Motor de terceros (repo git propio, no versionar aqui)
ref/ironwail/

# Claude runtime
.claude/scheduled_tasks.lock
